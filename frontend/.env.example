# Скопируйте в frontend/.env для локальной разработки.

# ID приложения из кабинета VK ID (https://id.vk.ru)
VITE_VK_APP_ID=

# Должен совпадать с «Доверенный Redirect URI» в настройках приложения VK ID
# и с VK_REDIRECT_URI на бэкенде. Локально обычно:
# VITE_VK_REDIRECT_URI=http://localhost:5173

# Яндекс OAuth — ID из https://oauth.yandex.com (тип «Вход через Яндекс ID»)
VITE_YANDEX_CLIENT_ID=
# VITE_YANDEX_REDIRECT_URI=http://localhost:5173

# Опционально: прямой URL бэкенда для Socket.IO (если UI не на localhost)
# VITE_COLLAB_WS_URL=http://127.0.0.1:3000
