# Copy to .env and adjust. Do not commit .env.
PORT=3000

# Required for JWT. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# VK ID (https://id.vk.ru) — вход через VK ID
VK_CLIENT_ID=
# Должен совпадать с redirect URI в кабинете VK ID и VITE_VK_REDIRECT_URI на фронте
VK_REDIRECT_URI=http://localhost:5173

# Яндекс OAuth (https://oauth.yandex.com) — тип приложения «Вход через Яндекс ID»
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:5173

# Required. Collab uses collections collab_rooms, collab_files, collab_folders, collab_peers (native driver, no Mongoose).
MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/sobesedovalka?authSource=sobesedovalka

# Optional: override database name instead of the one in the URI path
# MONGODB_DB=sobesedovalka
