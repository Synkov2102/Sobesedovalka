# Локально (docker-compose.local.yml): cp .env.example .env
# Прод на VPS: см. .env.production.example → положить как .env.production рядом с docker-compose.prod.yml

PORT=3000
# * или список через запятую: https://app.example.com
CORS_ORIGIN=*
JWT_SECRET=
# Обязательно для backend. Пример локально (Mongo на хосте): mongodb://host.docker.internal:27017/sobesedovalka
MONGODB_URI=

# --- Docker (docker-compose.local.yml): положите всё в корневой .env ---
# UI: http://localhost:8080 , API: http://localhost:8081 (внутри сети — backend:3000)
# Redirect URI в кабинетах VK / Яндекс для Docker: http://localhost:8080

# Backend (runtime)
VK_CLIENT_ID=
VK_REDIRECT_URI=http://localhost:8080
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8080

# Frontend (только при docker compose build — Vite build args)
VITE_VK_APP_ID=
VITE_VK_REDIRECT_URI=http://localhost:8080
VITE_YANDEX_CLIENT_ID=
VITE_YANDEX_REDIRECT_URI=http://localhost:8080

# --- npm run dev (без Docker): backend/.env + frontend/.env, redirect :5173 ---
