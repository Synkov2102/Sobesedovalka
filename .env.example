# Локально (Docker): cp .env.example .env → docker compose -f docker-compose.local.yml up --build
# Прод на VPS: .env.production.example → .env.production рядом с docker-compose.prod.yml
#
# npm run dev: OAuth только в backend/.env (фронт подставит VITE_* сам, см. frontend/vite.oauthEnv.ts).

PORT=3000
CORS_ORIGIN=*
JWT_SECRET=
MONGODB_URI=

# OAuth: один набор. Бэкенд читает при запуске; при docker compose build фронта
# compose сам подставит VK_* → VITE_VK_* (см. docker-compose.local.yml).
# Redirect URI = публичный URL UI (Docker :8080, dev :5173, прод — ваш домен).
VK_CLIENT_ID=
VK_REDIRECT_URI=http://localhost:8080
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8080

# Редко: отдельные значения только для сборки фронта (иначе не задавайте)
# VITE_VK_APP_ID=
# VITE_VK_REDIRECT_URI=
# VITE_YANDEX_CLIENT_ID=
# VITE_YANDEX_REDIRECT_URI=
