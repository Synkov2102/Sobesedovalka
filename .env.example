# Скопируйте в .env в корне репозитория:  cp .env.example .env
# Docker Compose подставляет эти переменные в docker-compose.*.yml (файл .env не коммитится).

PORT=3000
# * или список через запятую: https://app.example.com
CORS_ORIGIN=*
JWT_SECRET=
# Обязательно для backend. Пример локально (Mongo на хосте): mongodb://host.docker.internal:27017/sobesedovalka
MONGODB_URI=
