# На VPS: скопировать в .env.production рядом с docker-compose.prod.yml (файл не коммитится).

PORT=3000
# * — ок для HTTP-прода; для HTTPS укажите точный origin (и REST, и Socket.IO коллаба).
# Для прода лучше явный origin (нужен и для OAuth redirect fallback)
CORS_ORIGIN=https://sobesilka.ru
# Коллаб: открывайте приложение по тому же URL, что проксирует /api и /socket.io (обычно https://домен, порт 8080 снаружи).
# Если перед docker стоит внешний nginx/caddy — обязательно пробросьте WebSocket на /socket.io/.
JWT_SECRET=
MONGODB_URI=

VK_CLIENT_ID=
# Должен совпадать с origin сайта и с Redirect URI в кабинете VK ID (например https://sobesilka.ru)
VK_REDIRECT_URI=https://sobesilka.ru

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://sobesilka.ru

# Образ frontend из CI: VITE_* вшиваются при docker build (secrets в GitHub).
# На runtime контейнера достаточно VK_* / YANDEX_* выше + GET /api/auth/public-config.
