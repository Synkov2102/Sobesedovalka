# На VPS: скопировать в .env.production рядом с docker-compose.prod.yml (файл не коммитится).

PORT=3000
# * — ок для HTTP-прода; для HTTPS укажите точный origin (и REST, и Socket.IO коллаба).
CORS_ORIGIN=*
# Коллаб: открывайте приложение по тому же URL, что проксирует /api и /socket.io (обычно https://домен, порт 8080 снаружи).
# Если перед docker стоит внешний nginx/caddy — обязательно пробросьте WebSocket на /socket.io/.
JWT_SECRET=
MONGODB_URI=

VK_CLIENT_ID=
# Публичный URL фронтенда (тот же, что в кабинете VK ID)
VK_REDIRECT_URI=https://your-domain.example

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://your-domain.example

# Сборка образа frontend (CI / docker build --build-arg). Публичный URL без :8080, если за reverse proxy:
# VITE_VK_APP_ID=
# VITE_VK_REDIRECT_URI=https://your-domain.example
# VITE_YANDEX_CLIENT_ID=
# VITE_YANDEX_REDIRECT_URI=https://your-domain.example
